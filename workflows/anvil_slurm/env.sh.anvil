# anvil_cpu/env.sh.anvil -- machine file for Purdue Anvil. cp to env.sh, edit [EDIT].
#
# Everything site-specific is here: modules, MPI launcher, SLURM account and
# partitions, scratch paths. config.sh never needs editing per machine.
# ---------------------------------------------------------------------------

## --- modules --------------------------------------------------------------
# Anvil compute nodes: 2 x AMD EPYC 7763 (Milan, znver3), 128 cores, 256 GB.
# Pick ONE toolchain and build SPECFEM + mpi4py with it; mixing MPIs across the
# solver and the python venv is the silent-misfit failure mode (README).
if command -v module >/dev/null 2>&1; then
  module purge >/dev/null 2>&1 || true
  module load gcc/11.2.0 openmpi/4.1.6 2>/dev/null \
    || module load gcc openmpi 2>/dev/null \
    || echo "WARN: check 'module avail gcc openmpi' and fix env.sh [EDIT]" >&2
  # module load aocc/3.2.0 openmpi/4.1.6   # [EDIT] alternative: the ite3-era AOCC build
fi

## --- MPI ------------------------------------------------------------------
# Inside a SLURM allocation both work; srun binds ranks to the allocation
# without an hostfile. `mpi_run` in lib/common.sh spells the launch.
MPIRUN=srun                              # or: mpirun  (then MPIRUN_EXTRA="--bind-to core")
MPIRUN_EXTRA="${MPIRUN_EXTRA:---mpi=pmi2}"   # srun on Anvil/OpenMPI; drop if `srun` alone works
MPIFC=mpif90
MPICC=mpicc

## --- compilers ------------------------------------------------------------
FC=gfortran
CC=gcc
CXX=g++
FLAGS_CHECK="-O3 -march=znver3 -mtune=znver3 -funroll-loops"
CFLAGS_LOCAL="-O3 -march=znver3 -funroll-loops"
# Reuse the project tree's existing CPU build instead of rebuilding
# (1_build_specfem_cpu.sh --reuse copies its bin/ after a sanity check):
SPECFEM_REUSE_BIN="${SPECFEM_REUSE_BIN:-/anvil/projects/x-<allocation>/specfem3d-4.1.1_wb/bin}"   # [EDIT]

## --- SLURM ------------------------------------------------------------------
SLURM_ACCOUNT="<your-allocation>"                # [EDIT]  `sacctmgr show assoc user=$USER format=account`
PART_COMPUTE="wholenode"                 # 128-core nodes, up to 16 nodes/job, 96 h
PART_HIGHMEM="highmem"                   # 1 TB nodes (L-BFGS update at the 1 s mesh)
PART_DEBUG="debug"                       # smoke test / bench: 2 nodes, 2 h
PART_SHARED="shared"                     # single-node python stages that need <128 cores
SBATCH_EXTRA=""                          # e.g. "--mail-type=FAIL --mail-user=you@example.edu"

## --- paths on Anvil -----------------------------------------------------------
# $HOME is 25 GB: keep only this tree there. Data, models, work on scratch.
export SCRATCH="${SCRATCH:-/anvil/scratch/$USER}"
export WORKBASE="$SCRATCH/wb_s3/work"
export MODELBASE="$SCRATCH/wb_s3/models"
# The 3.6 GB raw stage-0 CC data + the 2 s-era observed bands live under
# CALADJ_DATA (config.sh default obs_data/ inside the tree; stage_to_anvil.sh
# puts it on scratch and symlinks obs_data -> there).

## --- Python (cal_adjoint) -------------------------------------------------
UV_BIN="${UV_BIN:-$HOME/.local/bin/uv}"
CALADJ_NODES=1
