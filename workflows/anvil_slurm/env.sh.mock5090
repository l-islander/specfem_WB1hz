# anvil_cpu/env.sh.mock5090 -- DRY-RUN machine file: exercise the SLURM drivers on
# the 5090 box with tools/mock_slurm (sequential, in-process "jobs"), the CUDA
# binaries run with GPU_MODE=.false., OpenMPI 4.1.2, 16 physical cores.
# cp env.sh.mock5090 env.sh  (only in a scratch copy of this tree -- see README)
export PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tools/mock_slurm:$PATH"
MPIRUN=mpirun
MPIRUN_EXTRA="--mca btl self,vader"
MPIFC=mpif90; MPICC=mpicc; FC=gfortran; CC=gcc
SLURM_ACCOUNT="mock"; PART_COMPUTE="mock"; PART_HIGHMEM="mock"; PART_DEBUG="mock"; PART_SHARED="mock"
CORES_PER_NODE=16                       # so NPROC=16 counts as "one node"
export MOCK_CPUS=16
SEISMO_FORMAT=bin
CALADJ_NPROC=16
UV_BIN=uv
