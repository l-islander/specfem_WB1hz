# ite3_gpu/env.sh -- toolchain for THIS box: Ubuntu 22.04 (jammy) under WSL2,
# RTX 5090 (sm_120), 32 cores, 30 GB RAM visible to WSL.
#
# Generated from env.sh.example after inspecting the machine. See the WSL notes
# at the bottom -- one of them (the CUDA package name) will silently break GPU
# access if you get it wrong.
# ---------------------------------------------------------------------------

## --- CUDA -----------------------------------------------------------------
# Install via the NVIDIA *wsl-ubuntu* repo (see notes), which lands in
# /usr/local/cuda-<ver> with a /usr/local/cuda symlink.
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64:${LD_LIBRARY_PATH:-}"

# WSL2 keeps the real libcuda.so (the Windows driver shim) in /usr/lib/wsl/lib,
# NOT in /usr/lib/x86_64-linux-gnu. WSL currently auto-generates
# /etc/ld.so.conf.d/ld.wsl.conf so ldconfig already finds it -- this line is
# belt-and-braces for the case where that file is disabled via wsl.conf
# (symptom: solver dies with "libcuda.so.1: cannot open shared object file").
export LD_LIBRARY_PATH="/usr/lib/wsl/lib:$LD_LIBRARY_PATH"

## --- MPI ------------------------------------------------------------------
# Ubuntu 22.04 ships OpenMPI 4.1.2 (apt install libopenmpi-dev openmpi-bin).
MPIRUN=mpirun
MPIFC=mpif90
MPICC=mpicc

# `vader` is the correct shared-memory BTL name for OpenMPI 4.x. (If you ever
# move to OpenMPI >= 5.0 it was renamed `sm` and this string becomes an error.)
# Restricting to self,vader stops OpenMPI probing the WSL virtual NIC and
# printing btl_tcp warnings on every single-rank launch.
MPIRUN_EXTRA="--mca btl self,vader"

## --- host compilers -------------------------------------------------------
# jammy default is gcc/gfortran 11.2 -- comfortably inside CUDA 12.8's supported
# host-compiler range (<= 14), so NVCC_EXTRA can stay empty here.
FC=gfortran
CC=gcc
CXX=g++

FLAGS_CHECK="-O3 -march=native -funroll-loops"
CFLAGS_LOCAL="-O3 -march=native -funroll-loops"

NVCC_EXTRA=""

## --- Python (cal_adjoint) -------------------------------------------------
UV_BIN="${UV_BIN:-uv}"

## --- resource limits ------------------------------------------------------
# Ryzen 9 9950X3D: 16 physical cores, 32 threads (SMT). `nproc`=32, but OpenMPI
# 4.1 counts SLOTS = physical cores (16) and REFUSES `mpirun -np 32` with
# "not enough slots" -- which is exactly what killed cal_adjoint at auto=32.
# Pin to the 16 physical cores: it's the fix AND the faster choice here --
# cal_adjoint is FP-heavy numpy/pyflex work, so 16 ranks each on a full core
# beat 32 SMT-contended ranks, and it avoids MPI busy-wait spinning under
# oversubscription. (To use all 32 threads instead, set this to 32 and add
# --use-hwthread-cpus to MPIRUN_EXTRA -- not recommended for this workload.)
CALADJ_NPROC=16

# WORKBASE: leave on the WSL ext4 root. Do NOT point it
# at /mnt/c, /mnt/d, /mnt/e or /mnt/f -- those are 9p mounts of the Windows
# drives, and the adjoint stage streams ~30 GB per event through WORKBASE.
# WORKBASE=$HOME/ite3_gpu/work        # the default; already correct
