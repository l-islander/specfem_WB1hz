# ite3_gpu/env.sh -- LOCAL MACHINE toolchain. Copy to env.sh and edit.
#
#     cp env.sh.example env.sh && ${EDITOR:-vi} env.sh
#
# This is the ONLY file that should ever need machine-specific edits. config.sh
# holds the science and the workflow; this holds "where is CUDA, which compiler,
# which mpirun". Every script sources config.sh then env.sh (if present), so
# anything set here overrides a config.sh default.
#
# On most Ubuntu/Debian boxes with the NVIDIA .deb toolkit and distro OpenMPI,
# the defaults below already work and you only need to check CUDA_HOME.
# ---------------------------------------------------------------------------

## --- CUDA -----------------------------------------------------------------
# sm_120 (RTX 5090 / Blackwell GeForce) requires CUDA toolkit >= 12.8.
# Check with: nvcc --version
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64:${LD_LIBRARY_PATH:-}"

## --- MPI ------------------------------------------------------------------
# SPECFEM is an MPI program even at NPROC=1 -- it calls MPI_Init unconditionally,
# so you still need a working MPI. Any of OpenMPI / MPICH works.
#   Ubuntu:  sudo apt install libopenmpi-dev openmpi-bin
#   Fedora:  sudo dnf install openmpi-devel && module load mpi/openmpi-x86_64
MPIRUN=mpirun
MPIFC=mpif90
MPICC=mpicc

# Extra flags for every launch. Common needs:
#   --allow-run-as-root                inside a docker container running as root
#   --mca btl self,vader               silence OpenMPI's TCP/IB probing on a
#                                      single node (harmless, but noisy)
#   --bind-to none                     if OpenMPI's default binding fights with
#                                      the CUDA runtime's thread placement
MPIRUN_EXTRA="--mca btl self,vader"

## --- host compilers -------------------------------------------------------
# Used for the Fortran/C parts of SPECFEM. gfortran is the well-tested choice.
# NOTE: nvcc refuses host compilers newer than it supports. With CUDA 12.8 that
# means gcc <= 14. If your distro default is newer, either install an older gcc
# and point CC/FC at it, or add -allow-unsupported-compiler to NVCC_EXTRA below.
FC=gfortran
CC=gcc
CXX=g++

# Host optimisation flags. The Anvil build uses -march=znver3 (Zen 3) which is
# WRONG on any other CPU. -march=native is the portable "best for this box".
# The solver's hot loops run on the GPU, so these matter far less than they did
# on Anvil -- do not spend time tuning them.
FLAGS_CHECK="-O3 -march=native -funroll-loops"
CFLAGS_LOCAL="-O3 -march=native -funroll-loops"

# Extra nvcc flags, appended to the -gencode this workflow computes from
# GPU_ARCH in config.sh. Usually empty.
#   -allow-unsupported-compiler   if nvcc complains about your gcc version
NVCC_EXTRA=""

## --- Python (cal_adjoint) -------------------------------------------------
# The adjoint-source pipeline runs in its own uv-managed venv (Python >= 3.10,
# numpy/scipy/obspy/mpi4py). build_env_local.sh creates it. `uv` must be on PATH:
#   curl -LsSf https://astral.sh/uv/install.sh | sh
UV_BIN="${UV_BIN:-uv}"

## --- resource limits ------------------------------------------------------
# How many CPU ranks the cal_adjoint MPI stages may use. 0 = auto (all physical
# cores). Lower it if you want to keep the box responsive; this stage runs while
# the GPU is idle, so it is the natural place to use the whole CPU.
# CALADJ_NPROC=16

# WORKBASE overrides where the big transient data goes. Point at your fastest
# large disk -- the adjoint stage streams ~30 GB per event through it.
# WORKBASE=/mnt/nvme/ite3_gpu_work
