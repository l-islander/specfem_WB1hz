# workflows/grace_hopper/env.sh.gh200 -- toolchain template for a Grace Hopper (GH200)
# node: aarch64 host (Grace, 72 cores/superchip) + H100-class GPU (sm_90).
#
#     cp workflows/grace_hopper/env.sh.gh200 workflows/rtx5090/env.sh && ${EDITOR:-vi} workflows/rtx5090/env.sh
#
# Every script sources config.sh THEN env.sh, so anything set here overrides a
# config.sh default. That is how the sm_120/CUDA-12.8 assumptions baked into
# config.sh for the RTX 5090 are undone for Hopper -- config.sh itself is not
# touched, which keeps the science/workflow file identical on both machines.
#
# Fill in the [EDIT] lines after `module avail` on the real system. Everything
# else is autodetected or is a documented fallback.
# ---------------------------------------------------------------------------

## --- module stack ----------------------------------------------------------
# [EDIT] Load whatever the site provides. Typical GH200 stacks (pick ONE row):
#   gcc + openmpi + cuda :  module load gcc/13 openmpi/5.0 cuda/12.6
#   nvhpc bundle        :  module load nvhpc/24.x   (brings nvfortran, its own OpenMPI, CUDA)
# gfortran is the tested path (x86 build uses gfortran 11.4). If only NVHPC is
# available, see the nvfortran notes at the bottom.
if command -v module >/dev/null 2>&1; then
  module purge >/dev/null 2>&1 || true
  # module load gcc openmpi cuda          # [EDIT]
fi

## --- GPU target (overrides config.sh) ---------------------------------------
# GH200 GPU = Hopper = compute capability 9.0. SPECFEM3D 4.1.1 ships sm_90
# natively, so 1_build_specfem_gpu.sh's GENCODE override resolves to the stock
# Hopper line and the build script's "compute_90 must not appear" guard is
# skipped for GPU_ARCH=90 (patched 2026-09-11).
GPU_ARCH=90
CUDA_MAJOR_MIN=12
CUDA_MINOR_MIN=0                          # any CUDA 12.x knows sm_90
GPU_DEVICE=0                              # single superchip; on a 2- or 4-GH200 node pick per job
GPU_VRAM_MIN_MB=12000

## --- CUDA -----------------------------------------------------------------
# After `module load cuda`, CUDA_HOME is usually exported by the module; the
# fallbacks below cover the common install prefixes on ARM nodes.
if [[ -z "${CUDA_HOME:-}" ]]; then
  for c in "${CUDA_PATH:-}" "${NVHPC_ROOT:+$NVHPC_ROOT/cuda}" /usr/local/cuda /opt/nvidia/cuda; do
    [[ -n "$c" && -f "$c/include/cuda_runtime.h" ]] && { CUDA_HOME="$c"; break; }
  done
fi
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib64:${LD_LIBRARY_PATH:-}"
# aarch64 toolkits sometimes ship the SBSA libs under targets/sbsa-linux/lib
[[ -d "$CUDA_HOME/targets/sbsa-linux/lib" ]] && \
  export LD_LIBRARY_PATH="$CUDA_HOME/targets/sbsa-linux/lib:$LD_LIBRARY_PATH"

## --- MPI ------------------------------------------------------------------
MPIRUN=mpirun
MPIFC=mpif90
MPICC=mpicc
# OpenMPI renamed the shared-memory BTL: 4.x = vader, >= 5.0 = sm. Passing the
# wrong name is a hard error at launch, so detect the major version. MPICH/
# Cray-MPICH/HPC-X-as-MPICH get no --mca flags at all.
if "$MPIRUN" --version 2>/dev/null | grep -qi "open mpi\|open-mpi\|openrte"; then
  _OMPI_MAJ=$("$MPIRUN" --version 2>/dev/null | sed -n 's/.*[^0-9]\([0-9]\+\)\.[0-9]\+\.[0-9]\+.*/\1/p' | head -1)
  if [[ "${_OMPI_MAJ:-4}" -ge 5 ]]; then MPIRUN_EXTRA="--mca btl self,sm"
  else                                    MPIRUN_EXTRA="--mca btl self,vader"; fi
else
  MPIRUN_EXTRA=""
fi
# HPC-X / Open MPI 4.1 on a 64 KiB-page aarch64 kernel: with default UCX settings a 72-rank launch
# hangs (UAR exhaustion). Needed on the measured node:
# MPIRUN_EXTRA="$MPIRUN_EXTRA --mca pml ob1 --mca osc ^ucx --mca coll ^hcoll,ucc"
# Under Slurm, `mpirun` inside an allocation is fine for these 1-rank GPU
# launches; do NOT switch MPIRUN to srun unless the site forbids mpirun
# (srun's flags differ and lib/common.sh:gpu_run passes -np).

## --- host compilers -------------------------------------------------------
FC=gfortran
CC=gcc
CXX=g++
# -march=native is valid on aarch64 GCC (>= 6) and resolves to Neoverse-V2 on
# Grace. The GPU does the hot loops; these flags barely matter.
FLAGS_CHECK="-O3 -march=native -funroll-loops"
CFLAGS_LOCAL="-O3 -march=native -funroll-loops"
# nvcc rejects host gcc newer than it supports (CUDA 12.4: gcc <= 13; 12.6/12.8:
# gcc <= 14). If `module load gcc` gives you something newer, uncomment:
NVCC_EXTRA=""
# NVCC_EXTRA="-allow-unsupported-compiler"

## --- Python (cal_adjoint) -------------------------------------------------
# uv has aarch64 builds. Pin CPython 3.10: with Python >= 3.11 uv.lock selects numpy 2.4.4 and the
# vendored pyflex raises TypeError (measured on the GH200 node). mpi4py is rebuilt from source
# against $MPICC by cal_adjoint/build_env_local.sh.
#   curl -LsSf https://astral.sh/uv/install.sh | sh
export UV_PYTHON=3.10
UV_BIN="${UV_BIN:-uv}"

## --- resource limits ------------------------------------------------------
# Physical cores visible to this job (Grace: 72 per superchip, no SMT). Under a
# scheduler this is the allocation's cpuset, which is what we want.
CALADJ_NPROC=$( { lscpu -p=CORE 2>/dev/null | grep -v '^#' | sort -u | wc -l; } || nproc )
[[ "${CALADJ_NPROC:-0}" -gt 0 ]] || CALADJ_NPROC=$(nproc)

## --- seismogram format ----------------------------------------------------
# Binary traces (SPECFEM's USE_BINARY_FOR_SEISMOGRAMS). Validated on the 5090
# 2026-09-11: identical seismograms (6.8e-6 max rel. diff vs the ascii
# reference, below the 8.3e-6 run-to-run floor), identical misfit, and the
# per-event seismogram write dropped from 17.2 s to 0.24 s (solver total
# 73.0 -> 49.5 s on the same event; 217 MB -> 27 MB per event). Every reader
# detects the format per file, and the ascii x86 reference stays comparable
# (workflows/grace_hopper/validate_forward.py handles mixed formats).
SEISMO_FORMAT=bin

## --- disks ----------------------------------------------------------------
# [EDIT] WORKBASE must be a FAST LOCAL or parallel scratch: the adjoint stage
# streams ~30 GB per event through it and the forward writes ~250 MB of ASCII
# seismograms per event. MODELBASE stays in the (backed-up) home tree.
# WORKBASE=/scratch/$USER/ite3_gpu_work
# MODELBASE=$HOME/ite3_gpu/models

## --- NVHPC / nvfortran notes (only if gfortran is unavailable) ------------
# FC=nvfortran CC=nvc CXX=nvc++ MPIFC=mpifort MPICC=mpicc
# FLAGS_CHECK="-O3 -fast -tp=native"    CFLAGS_LOCAL="-O3 -fast -tp=native"
# configure's flags.guess knows nvfortran (as "pgf90/nvfortran"); if it errors on
# -march=native that is these FLAGS_CHECK/CFLAGS_LOCAL lines, not the script.
